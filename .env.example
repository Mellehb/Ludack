# Stripe — Test mode keys to start with (later vervangen door live keys op Netlify)
# Server-side (Netlify Functions only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Client-side (must start with VITE_ to be exposed to browser bundle)
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Public site URL (used in Stripe success_url / cancel_url)
# Lokaal: http://localhost:8888 (netlify dev)  |  Productie: https://<jouw-site>.netlify.app
URL=http://localhost:8888
